+  ready4 = r > 0 && client->listenSock != RFB_INVALID_SOCKET && FD_ISSET(client->listenSock, &fds);
+  ready6 = r > 0 && client->listen6Sock != RFB_INVALID_SOCKET && FD_ISSET(client->listen6Sock, &fds);
