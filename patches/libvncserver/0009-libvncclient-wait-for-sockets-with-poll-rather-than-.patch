From 6aef5233efa6795c272dd16604d22e06582efc09 Mon Sep 17 00:00:00 2001
From: "Claude Opus 5.5" <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 19:05:02 -0400
Subject: [PATCH 9/9] libvncclient: wait for sockets with poll() rather than
 select()

select() takes an fd_set, a bitmap of FD_SETSIZE (1024) bits, so a
socket at descriptor 1024 or above is set past its end: with glibc the
kernel then reads and writes back bits of the caller's stack, and with
_FORTIFY_SOURCE or on bionic FD_SET aborts. A client in a process with
many open files gets such a socket. With the socket at descriptor 1102,
the first WaitForMessage() overwrote ReadFromRFBServer()'s frame and the
client crashed.

Wait with poll() instead, through a new sock_wait() in common/sockets.c,
in WaitForMessage(), WriteToRFBServer(), sock_wait_for_connected(), the
OpenSSL handshake, and both listen functions. The timeouts stay as they
were, rounded up to whole milliseconds. A socket with an error or a
closed connection counts as ready, as it did, so the read or write after
the wait reports it. Windows keeps select(), whose fd_set is a list of
sockets with no limit on their values, and in sock_wait_for_connected()
also the exceptfds that report a failed connect there.

The connect wait is for POLLOUT, which a connection in progress reports
once it is made or has failed. An earlier change to poll() (993df689,
reverted in 7dd27504) waited for POLLIN there, which comes only once
the other end sends something, and so broke a server's connection to
an RFB repeater: the repeater waits for the server to speak first.

WriteToTLS() retried GNUTLS_E_AGAIN at once, a busy loop for as long as
the socket's send buffer was full, and the OpenSSL one did the same for
SSL_ERROR_WANT_WRITE. Both now wait for the socket like
WriteToRFBServer(), without a limit when writing, and only briefly when
the library wants to read, since another thread may read what arrives.
The OpenSSL handshake waits for writing on SSL_ERROR_WANT_WRITE, where it
waited for reading.

diff --git a/include/rfb/rfbclient.h b/include/rfb/rfbclient.h
index ee8c285..7837a43 100644
--- a/include/rfb/rfbclient.h
+++ b/include/rfb/rfbclient.h
@@ -490,7 +490,7 @@ typedef struct _rfbClient {
 
 #endif
 #endif
-	/* timeout in seconds for select() after connect() */
+	/* timeout in seconds for the wait after connect() */
 	unsigned int connectTimeout;
 
 	/* timeout in seconds when reading from half-open connections in
@@ -860,7 +860,7 @@ extern rfbBool SameMachine(rfbSocket sock);
  * will return.
  * @param client The client to cause to wait until a message is received
  * @param usecs The timeout in microseconds
- * @return the return value of the underlying select() call
+ * @return the return value of the underlying poll() call (select() on Windows)
  */
 extern int WaitForMessage(rfbClient* client,unsigned int usecs);
 
diff --git a/src/common/sockets.c b/src/common/sockets.c
index 32fe1a1..71f45e1 100644
--- a/src/common/sockets.c
+++ b/src/common/sockets.c
@@ -24,6 +24,7 @@
 
 #include <errno.h>
 #include <fcntl.h>
+#include <limits.h>
 #include <string.h>
 
 #include "sockets.h"
@@ -53,6 +54,7 @@ rfbBool sock_set_nonblocking(rfbSocket sock, rfbBool non_blocking, void (*log)(c
 
 rfbBool sock_wait_for_connected(int socket, unsigned int timeout_seconds)
 {
+#ifdef WIN32
   fd_set writefds;
   fd_set exceptfds;
   struct timeval timeout;
@@ -65,26 +67,77 @@ rfbBool sock_wait_for_connected(int socket, unsigned int timeout_seconds)
       return FALSE;
   }
 
+  /* Windows reports a failed connect in exceptfds; WSAPoll() did not report
+     it at all before Windows 10 2004. */
   FD_ZERO(&writefds);
   FD_SET(socket, &writefds);
   FD_ZERO(&exceptfds);
   FD_SET(socket, &exceptfds);
   if (select(socket+1, NULL, &writefds, &exceptfds, &timeout)==1) {
-#ifdef WIN32
     if (FD_ISSET(socket, &exceptfds))
       return FALSE;
-#else
-    int so_error;
-    socklen_t len = sizeof so_error;
-    getsockopt(socket, SOL_SOCKET, SO_ERROR, &so_error, &len);
-    if (so_error!=0)
-      return FALSE;
-#endif
     return TRUE;
   }
 
   return FALSE;
+#else
+  int so_error;
+  socklen_t len = sizeof so_error;
+  int timeout_ms = timeout_seconds > INT_MAX / 1000 ? -1 : (int)timeout_seconds * 1000;
+
+  /* A connection in progress becomes writable when it is made or has failed.
+     It does not become readable until the other end sends something, which
+     an RFB repeater waits for the server to do first. */
+  if (sock_wait(socket, TRUE, timeout_ms) <= 0)
+    return FALSE;
+
+  getsockopt(socket, SOL_SOCKET, SO_ERROR, &so_error, &len);
+  if (so_error!=0)
+    return FALSE;
+  return TRUE;
+#endif
 }
 
 
+int sock_wait(rfbSocket sock, rfbBool for_writing, int timeout_ms)
+{
+#ifdef WIN32
+  fd_set fds;
+  struct timeval timeout;
+  int r;
+
+  if(sock == RFB_INVALID_SOCKET) {
+      errno = EBADF;
+      return -1;
+  }
+
+  timeout.tv_sec = timeout_ms / 1000;
+  timeout.tv_usec = (timeout_ms % 1000) * 1000;
+  FD_ZERO(&fds);
+  FD_SET(sock, &fds);
+  r = select(sock+1, for_writing ? NULL : &fds, for_writing ? &fds : NULL, NULL,
+             timeout_ms < 0 ? NULL : &timeout);
+  if (r < 0)
+    errno = WSAGetLastError();
+  return r;
+#else
+  struct pollfd pfd;
+  int r;
 
+  if(sock == RFB_INVALID_SOCKET) {
+      errno = EBADF;
+      return -1;
+  }
+
+  pfd.fd = sock;
+  pfd.events = for_writing ? POLLOUT : POLLIN;
+  pfd.revents = 0;
+  r = poll(&pfd, 1, timeout_ms < 0 ? -1 : timeout_ms);
+  /* select() fails on a descriptor that is not open, poll() reports it */
+  if (r > 0 && (pfd.revents & POLLNVAL)) {
+    errno = EBADF;
+    return -1;
+  }
+  return r;
+#endif
+}
diff --git a/src/common/sockets.h b/src/common/sockets.h
index 99a2f15..58289a8 100644
--- a/src/common/sockets.h
+++ b/src/common/sockets.h
@@ -62,6 +62,7 @@
 #include <arpa/inet.h>
 #include <netinet/tcp.h>
 #include <netdb.h>
+#include <poll.h>
 #endif
 
 /*
@@ -83,4 +84,17 @@ rfbBool sock_set_nonblocking(rfbSocket sock, rfbBool non_blocking, void (*log)(c
 rfbBool sock_wait_for_connected(int socket, unsigned int timeout_seconds);
 
 
+/*
+   Wait for a socket to become readable, or writable if for_writing is TRUE,
+   for at most timeout_ms milliseconds, or without a limit if timeout_ms is
+   negative. A socket with a pending error or a closed connection counts as
+   ready, so that the next read or write reports it.
+   Returns a positive number when the socket is ready, 0 on timeout, and -1
+   on failure with errno set (EINTR when interrupted by a signal).
+   Uses poll() where select() would be limited to descriptors below
+   FD_SETSIZE; on Windows select() takes any socket and is used instead.
+*/
+int sock_wait(rfbSocket sock, rfbBool for_writing, int timeout_ms);
+
+
 #endif /* _RFB_COMMON_SOCKETS_H */
