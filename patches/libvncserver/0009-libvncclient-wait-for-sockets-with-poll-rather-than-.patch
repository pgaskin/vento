diff --git a/src/libvncclient/tls_gnutls.c b/src/libvncclient/tls_gnutls.c
index be914c7..f957fc4 100644
--- a/src/libvncclient/tls_gnutls.c
+++ b/src/libvncclient/tls_gnutls.c
@@ -445,22 +445,24 @@ SetTLSAnonCredential(rfbClient* client)
    the length of the whole-handshake deadline it had before. */
 #define TLS_HANDSHAKE_WAIT_MS 15000
 
-/* Waits until the socket can be read or written, whichever gnutls was
-   interrupted doing. FALSE when the wait failed, with errno set: to
-   ETIMEDOUT when nothing happened for TLS_HANDSHAKE_WAIT_MS. poll() rather
-   than select(), which cannot take a descriptor of FD_SETSIZE or above. */
+/* Waits until the socket can be written if for_writing, else read: the
+   direction gnutls_record_get_direction() gives after an interrupted call.
+   At most timeout_ms, or without a limit if it is negative. FALSE when the
+   wait failed, with errno set: to ETIMEDOUT when nothing happened in time.
+   poll() rather than select(), which cannot take a descriptor of
+   FD_SETSIZE or above. */
 static rfbBool
-WaitForTLSSocket(rfbClient* client)
+WaitForTLSSocket(rfbClient* client, int for_writing, int timeout_ms)
 {
   struct pollfd pfd;
   int ret;
 
   pfd.fd = client->sock;
-  pfd.events = gnutls_record_get_direction((gnutls_session_t)client->tlsSession) ? POLLOUT : POLLIN;
+  pfd.events = for_writing ? POLLOUT : POLLIN;
   while (1)
   {
     pfd.revents = 0;
-    ret = poll(&pfd, 1, TLS_HANDSHAKE_WAIT_MS);
+    ret = poll(&pfd, 1, timeout_ms < 0 ? -1 : timeout_ms);
     if (ret > 0) return TRUE;
     if (ret == 0)
     {
@@ -482,7 +484,9 @@ HandshakeTLS(rfbClient* client)
        or no room to write: wait for it rather than retrying at once. */
     if (ret == GNUTLS_E_AGAIN || ret == GNUTLS_E_INTERRUPTED)
     {
-      if (WaitForTLSSocket(client)) continue;
+      if (WaitForTLSSocket(client, gnutls_record_get_direction((gnutls_session_t)client->tlsSession),
+                           TLS_HANDSHAKE_WAIT_MS))
+        continue;
       if (errno == ETIMEDOUT)
         rfbClientLog("TLS handshake failed: the server did not answer for %d seconds.\n",
                      TLS_HANDSHAKE_WAIT_MS / 1000);
@@ -853,17 +857,31 @@ WriteToTLS(rfbClient* client, const char *buf, unsigned int n)
 {
   unsigned int offset = 0;
   ssize_t ret;
+  int for_writing;
 
   while (offset < n)
   {
     LOCK(client->tlsRwMutex);
     ret = gnutls_record_send((gnutls_session_t)client->tlsSession, buf+offset, (size_t)(n-offset));
+    /* under the lock, since a ReadFromTLS in another thread changes it */
+    for_writing = gnutls_record_get_direction((gnutls_session_t)client->tlsSession);
     UNLOCK(client->tlsRwMutex);
 
     if (ret == 0) continue;
     if (ret < 0)
     {
-      if (ret == GNUTLS_E_AGAIN || ret == GNUTLS_E_INTERRUPTED) continue;
+      if (ret == GNUTLS_E_AGAIN || ret == GNUTLS_E_INTERRUPTED)
+      {
+        /* The socket is non-blocking, so this means that it has no room:
+           wait for it, as WriteToRFBServer does, rather than retrying at
+           once. Should gnutls want to read instead, what arrives may go to
+           a ReadFromTLS in another thread, so that wait is short. */
+        if (WaitForTLSSocket(client, for_writing, for_writing ? -1 : 100)
+            || errno == ETIMEDOUT)
+          continue;
+        rfbClientLog("Error writing to TLS: %s.\n", strerror(errno));
+        return -1;
+      }
       rfbClientLog("Error writing to TLS: %s.\n", gnutls_strerror(ret));
       return -1;
     }
