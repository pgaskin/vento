From 7e89726d14c7fc339515d6ce485e162ed0fab67b Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Wed, 12 Aug 2026 21:27:45 -0400
Subject: [PATCH 3/5] libvncclient: no VeNCrypt Plain either
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Plain is not anonymous TLS, it is no TLS: as a top-level VeNCrypt type it
sends the user name and password in the clear. The library treats it as a
weak pick it will upgrade away from, so it is only ever chosen when it is
the only acceptable offer — and in that case this client should refuse the
server rather than authenticate to it in plain text, which is what the
TigerVNC backend beside it already does with the same list.

diff --git a/src/libvncclient/tls_gnutls.c b/src/libvncclient/tls_gnutls.c
index 16c5218..71b36a1 100644
--- a/src/libvncclient/tls_gnutls.c
+++ b/src/libvncclient/tls_gnutls.c
@@ -455,13 +455,15 @@ ReadVeNCryptSecurityType(rfbClient* client, uint32_t *result)
            against somebody in the middle, since the server proves nothing
            about itself and there is no certificate to pin. So they are offered
            only when the caller has installed ConfirmAnonymousTLS, which is
-           where that is put to whoever is at this end.
+           where that is put to whoever is at this end. rfbVeNCryptPlain is out
+           for a plainer reason: as a top-level type there is no TLS under it
+           at all, so it is the user name and password on the wire in the
+           clear.
 
            rfbVeNCryptTLSSASL is left out with them and stays out: it is the
            same tunnel with an authentication this client does not build. */
         if (t==rfbNoAuth ||
             t==rfbVncAuth ||
-            t==rfbVeNCryptPlain ||
             ((t==rfbVeNCryptTLSNone ||
               t==rfbVeNCryptTLSVNC ||
               t==rfbVeNCryptTLSPlain) && client->ConfirmAnonymousTLS) ||
@@ -476,7 +478,6 @@ ReadVeNCryptSecurityType(rfbClient* client, uint32_t *result)
                 authScheme==0 ||
                 authScheme==rfbNoAuth ||
                 authScheme==rfbVncAuth ||
-                authScheme==rfbVeNCryptPlain ||
                 /* An anonymous tunnel is better than none and worse than a
                    checked one, and the server's list is in the server's order:
                    without these three a server naming TLSVnc before X509Vnc
