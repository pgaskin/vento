From 64e700cdf76f379d09c08c5e4458cee6658a647d Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Wed, 12 Aug 2026 21:27:45 -0400
Subject: [PATCH 3/5] libvncclient: no VeNCrypt Plain either
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Plain is not anonymous TLS, it is no TLS: as a top-level VeNCrypt type it
sends the user name and password in the clear. The library treats it as a
weak pick it will upgrade away from, so it is only ever chosen when it is
the only acceptable offer — and in that case this client should refuse the
server rather than authenticate to it in plain text, which is what the
TigerVNC backend beside it already does with the same list.

diff --git a/src/libvncclient/tls_gnutls.c b/src/libvncclient/tls_gnutls.c
index c0b469b..efb00cd 100644
--- a/src/libvncclient/tls_gnutls.c
+++ b/src/libvncclient/tls_gnutls.c
@@ -455,10 +455,11 @@ ReadVeNCryptSecurityType(rfbClient* client, uint32_t *result)
            against somebody in the middle, since the server proves nothing
            about itself and there is no certificate to pin. They are left out
            deliberately, so that a server offering both is talked to over the
-           one that has an identity. */
+           one that has an identity. rfbVeNCryptPlain is out for a plainer
+           reason: as a top-level type there is no TLS under it at all, so it
+           is the user name and password on the wire in the clear. */
         if (t==rfbNoAuth ||
             t==rfbVncAuth ||
-            t==rfbVeNCryptPlain ||
 #ifdef LIBVNCSERVER_HAVE_SASL
             t==rfbVeNCryptX509SASL ||
 #endif /*LIBVNCSERVER_HAVE_SASL */
@@ -469,8 +470,7 @@ ReadVeNCryptSecurityType(rfbClient* client, uint32_t *result)
             if (
                 authScheme==0 ||
                 authScheme==rfbNoAuth ||
-                authScheme==rfbVncAuth ||
-                authScheme==rfbVeNCryptPlain)
+                authScheme==rfbVncAuth)
             {
                 /* for security reasons, the encrypted type has a higher priority */
                 origAuthScheme=tAuth[loop];
