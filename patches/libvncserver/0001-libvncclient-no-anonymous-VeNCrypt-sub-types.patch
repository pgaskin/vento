From 0180966d69651d1d2b66190125bd7923b4feb741 Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Wed, 12 Aug 2026 04:04:45 -0400
Subject: [PATCH 1/5] libvncclient: no anonymous VeNCrypt sub-types
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

TLSNone, TLSVnc and TLSPlain are VeNCrypt over an anonymous key
exchange. They encrypt the line and prove nothing about the far end,
and there is no certificate to pin afterwards — so a server that offers
both them and the X509 family would be talked to over whichever came
first in its list. Removing them from the acceptable set is what makes
the choice ours.

diff --git a/src/libvncclient/tls_gnutls.c b/src/libvncclient/tls_gnutls.c
index 6e46029..4501ebf 100644
--- a/src/libvncclient/tls_gnutls.c
+++ b/src/libvncclient/tls_gnutls.c
@@ -443,14 +443,16 @@ ReadVeNCryptSecurityType(rfbClient* client, uint32_t *result)
         if (!ReadFromRFBServer(client, (char *)&tAuth[loop], 4)) return FALSE;
         t=rfbClientSwap32IfLE(tAuth[loop]);
         rfbClientLog("%d) Received security type %d\n", loop, t);
+        /* The rfbVeNCryptTLS* sub-types are TLS over an anonymous key
+           exchange: encrypted against somebody listening, worth nothing
+           against somebody in the middle, since the server proves nothing
+           about itself and there is no certificate to pin. They are left out
+           deliberately, so that a server offering both is talked to over the
+           one that has an identity. */
         if (t==rfbNoAuth ||
             t==rfbVncAuth ||
             t==rfbVeNCryptPlain ||
-            t==rfbVeNCryptTLSNone ||
-            t==rfbVeNCryptTLSVNC ||
-            t==rfbVeNCryptTLSPlain ||
 #ifdef LIBVNCSERVER_HAVE_SASL
-            t==rfbVeNCryptTLSSASL ||
             t==rfbVeNCryptX509SASL ||
 #endif /*LIBVNCSERVER_HAVE_SASL */
             t==rfbVeNCryptX509None ||
