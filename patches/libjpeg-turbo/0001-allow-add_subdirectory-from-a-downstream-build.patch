From 9de8c336bf5e79bd9a22f16ce4b380705b36309c Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Tue, 11 Aug 2026 22:26:15 -0400
Subject: [PATCH 1/1] allow add_subdirectory() from a downstream build
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The guard exists because integrating this build system into another one is
awkward in general. This build wants one thing from it — the static decoder
libvncclient links against for Tight — and builds it beside libvncserver
under the NDK toolchain the Android Gradle plugin has already configured.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7a43187c..a43f978c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -66,9 +66,7 @@ endif()
 # ExternalProject_Add() or make downstream modifications to the libjpeg-turbo
 # build system to suit their specific needs.  Please do not file bug reports,
 # feature requests, or pull requests regarding this.
-if(NOT CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
-  message(FATAL_ERROR "The ${CMAKE_PROJECT_NAME} build system cannot be integrated into another build system using add_subdirectory().  Use ExternalProject_Add() instead.")
-endif()
+
 
 # CMake 3.14 and later sets CMAKE_MACOSX_BUNDLE to TRUE by default when
 # CMAKE_SYSTEM_NAME is iOS, tvOS, or watchOS, which breaks the libjpeg-turbo
