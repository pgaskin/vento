+    /// The active RandR 1.5 monitors, in the server's order, each with the CRTC that shows its
+    /// first output (`crtc_infos` are `resources`' CRTCs, in order).
+    fn query_randr_monitors(
+        &self,
+        resources: &ScreenResources,
+        crtc_infos: &[randr::GetCrtcInfoReply],
+    ) -> Result<Vec<MonitorHandle>, X11Error> {
+        let conn = self.xcb_connection();
+        let reply = conn.randr_get_monitors(self.default_root().root, true)?.reply()?;
+
+        // Pipeline the name lookups.
+        let mut name_cookies = Vec::with_capacity(reply.monitors.len());
+        for info in &reply.monitors {
+            name_cookies.push(conn.get_atom_name(info.name)?);
+        }
+
+        let mut monitors = Vec::with_capacity(reply.monitors.len());
+        for (info, cookie) in reply.monitors.iter().zip(name_cookies) {
+            let name = String::from_utf8_lossy(&cookie.reply()?.name).into_owned();
+            let crtc = info.outputs.first().and_then(|output| {
+                resources
+                    .crtcs()
+                    .iter()
+                    .zip(crtc_infos)
+                    .find(|(_, crtc)| crtc.outputs.contains(output))
+                    .map(|(&id, crtc)| (id, crtc))
+            });
+            monitors.push(MonitorHandle::from_monitor_info(self, resources, info, name, crtc));
+        }
+
+        if !monitors.iter().any(|monitor| monitor.primary) {
+            if let Some(fallback) = monitors.first_mut() {
+                fallback.primary = true;
+            }
+        }
+        Ok(monitors)
+    }
+
