+    /// A RandR 1.5 monitor, as `RRGetMonitors` describes it, shown by `crtc` where one does.
+    fn from_monitor_info(
+        xconn: &XConnection,
+        resources: &ScreenResources,
+        info: &randr::MonitorInfo,
+        name: String,
+        crtc: Option<(randr::Crtc, &randr::GetCrtcInfoReply)>,
+    ) -> Self {
+        let dimensions = (info.width as u32, info.height as u32);
+        let position = (info.x as i32, info.y as i32);
+        let scale_factor = xconn.scale_factor_for(
+            dimensions,
+            (info.width_in_millimeters as u64, info.height_in_millimeters as u64),
+        );
+
+        let (id, refresh_rate_millihertz, video_modes) = match crtc {
+            Some((id, crtc)) => {
+                let refresh_rate_millihertz = resources
+                    .modes()
+                    .iter()
+                    .find(|mode| mode.id == crtc.mode)
+                    .and_then(mode_refresh_rate_millihertz);
+                // A video mode is set on the whole CRTC, so a monitor that is only part of one
+                // has none to offer: setting one would change every monitor the CRTC shows.
+                let whole = (crtc.x, crtc.y, crtc.width, crtc.height)
+                    == (info.x, info.y, info.width, info.height);
+                let video_modes = if whole {
+                    xconn
+                        .get_output_modes(resources, info.outputs[0])
+                        .map(|(_, _, modes)| modes)
+                        .unwrap_or_default()
+                } else {
+                    Vec::new()
+                };
+                (id, refresh_rate_millihertz, video_modes)
+            },
+            None => (0, None, Vec::new()),
+        };
+
+        MonitorHandle {
+            id,
+            monitor: Some(info.name),
+            name,
+            refresh_rate_millihertz,
+            scale_factor,
+            dimensions,
+            position,
+            primary: info.primary,
+            rect: util::AaRect::new(position, dimensions),
+            video_modes,
+        }
+    }
+
