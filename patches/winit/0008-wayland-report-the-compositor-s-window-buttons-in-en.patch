+    /// What the compositor offers to do with the window (xdg-shell v5's `wm_capabilities`), as
+    /// of the last configure. A compositor that never says offers everything, as the protocol
+    /// has it, and so does a window not yet configured.
+    #[inline]
+    pub fn wm_capabilities(&self) -> WindowManagerCapabilities {
+        self.last_configure
+            .as_ref()
+            .map_or(WindowManagerCapabilities::all(), |configure| configure.capabilities)
+    }
