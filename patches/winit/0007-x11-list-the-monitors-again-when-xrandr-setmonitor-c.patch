diff --git a/src/platform_impl/linux/x11/monitor.rs b/src/platform_impl/linux/x11/monitor.rs
index 87924d5..4b0e28c 100644
--- a/src/platform_impl/linux/x11/monitor.rs
+++ b/src/platform_impl/linux/x11/monitor.rs
@@ -406,6 +406,21 @@ impl XConnection {
             .unwrap_or_else(MonitorHandle::dummy))
     }
 
+    /// `xrandr --setmonitor` and `--delmonitor` change the RandR 1.5 monitors with no RandR
+    /// event, only a ConfigureNotify on the root window, so that too has the monitors listed
+    /// again. The root's event mask is this client's own, kept as it was and added to.
+    pub fn select_root_configure(&self, root: xproto::Window) -> Result<(), X11Error> {
+        let conn = self.xcb_connection();
+        let mask = conn.get_window_attributes(root)?.reply()?.your_event_mask;
+        conn.change_window_attributes(
+            root,
+            &xproto::ChangeWindowAttributesAux::new()
+                .event_mask(mask | xproto::EventMask::STRUCTURE_NOTIFY),
+        )?
+        .check()?;
+        Ok(())
+    }
+
