From 522ccd6ce632a114e7200241f5a835109a90136a Mon Sep 17 00:00:00 2001
From: Claude Opus 5 <noreply@anthropic.com>
Date: Sun, 16 Aug 2026 14:45:46 -0400
Subject: [PATCH 5/5] rfb: anonymous TLS is the client's question, and never
 its first choice
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The TLS* security types bring up a tunnel with no certificate in it, and
checkSession returns immediately for them: nothing to verify, nothing to
write to the known-hosts file, and nothing said. A session over one is
then indistinguishable from a checked one, which is the part worth
fixing — a client cannot tell its user what the session is if it is
never told itself.

So CConnection gains confirmAnonymousTLS(), called there, doing nothing
by default. A client that wants to refuse or to ask throws from it.

The sub-type choice becomes two passes over the server's own order,
anything with a certificate in it first. The server's list is the
server's order and the first match won, so a server naming TLSVnc before
X509Vnc decided for the client that its identity would not be checked.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/common/rfb/CConnection.h b/common/rfb/CConnection.h
index 9d999f8a..2408153a 100644
--- a/common/rfb/CConnection.h
+++ b/common/rfb/CConnection.h
@@ -200,6 +200,13 @@ namespace rfb {
     virtual bool verifyHostKey(const uint8_t* key, size_t length,
                                const char* fingerprint) = 0;
 
+    // confirmAnonymousTLS() is called once a TLS* security type has brought
+    // up a tunnel with no certificate in it, before anything is authenticated
+    // inside it.  There is nothing to check and nothing to remember, so a
+    // client that wants to refuse or to ask throws from here; doing nothing
+    // goes on with the session.
+    virtual void confirmAnonymousTLS() {}
+
   protected:
 
     // Methods overridden from CMsgHandler
diff --git a/common/rfb/CSecurityTLS.cxx b/common/rfb/CSecurityTLS.cxx
index b9bdb3af..9faa918f 100644
--- a/common/rfb/CSecurityTLS.cxx
+++ b/common/rfb/CSecurityTLS.cxx
@@ -299,8 +299,14 @@ void CSecurityTLS::checkSession()
   unsigned int cert_list_size = 0;
   int err;
 
-  if (anon)
+  /* An anonymous key exchange leaves nothing to check: no certificate, no
+     name, nothing to write into the known-hosts file. Going on silently is
+     what makes such a session indistinguishable from a checked one, so the
+     client is told and decides. */
+  if (anon) {
+    cc->confirmAnonymousTLS();
     return;
+  }
 
   if (gnutls_certificate_type_get(session) != GNUTLS_CRT_X509) {
     gnutls_alert_send(session, GNUTLS_AL_FATAL,
diff --git a/common/rfb/CSecurityVeNCrypt.cxx b/common/rfb/CSecurityVeNCrypt.cxx
index 9fbdde88..7e2876eb 100644
--- a/common/rfb/CSecurityVeNCrypt.cxx
+++ b/common/rfb/CSecurityVeNCrypt.cxx
@@ -165,12 +165,23 @@ bool CSecurityVeNCrypt::processMsg()
 
       secTypes = security->GetEnabledExtSecTypes();
 
-      /* Honor server's security type order */
-      for (i = 0; i < nAvailableTypes; i++) {
-        if (std::find(secTypes.begin(), secTypes.end(),
-                      availableTypes[i]) != secTypes.end()) {
-          chosenType = availableTypes[i];
-          break;
+      /* Honor server's security type order, in two passes: anything with a
+         certificate in it before the anonymous TLS* family, which proves
+         nothing about the server and is worth taking only when it is all
+         there is. The server's list is the server's order, so without this a
+         server naming TLSVnc before X509Vnc decides that for the client. */
+      for (int pass = 0; pass < 2 && chosenType == secTypeInvalid; pass++) {
+        for (i = 0; i < nAvailableTypes; i++) {
+          bool anonymous = availableTypes[i] == secTypeTLSNone ||
+                           availableTypes[i] == secTypeTLSVnc ||
+                           availableTypes[i] == secTypeTLSPlain;
+          if (anonymous != (pass == 1))
+            continue;
+          if (std::find(secTypes.begin(), secTypes.end(),
+                        availableTypes[i]) != secTypes.end()) {
+            chosenType = availableTypes[i];
+            break;
+          }
         }
       }
 
