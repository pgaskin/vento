-/// Format: 1 byte top_down, 1 byte spice_format, then per-row blocks
-/// each with a 4-byte big-endian compressed size followed by the LZ4
-/// compressed row data. Returns RGBA pixels.
+/// Format: 1 byte top_down, 1 byte spice_format, then one block per
+/// chunk of the source bitmap, each with a 4-byte big-endian
+/// compressed size followed by the LZ4 compressed rows. Returns RGBA
+/// pixels.
 use tracing::{debug, warn};
 
 use crate::DecompressedImage;
@@ -41,12 +42,23 @@ pub fn decompress_spice_lz4(data: &[u8], width: usize, height: usize) -> Option<
     let row_bytes = width * bpp;
     let total_pixels = width.checked_mul(height)?;
     let rgba_size = total_pixels.checked_mul(4)?;
+    let raw_size = row_bytes.checked_mul(height)?;
     let mut rgba = vec![0u8; rgba_size];
 
+    // The blocks are the source bitmap's *chunks* rather than its rows:
+    // spice-server compresses each QXLDataChunk in one call, and a bitmap that
+    // fits in one chunk — which a whole desktop does — arrives as a single
+    // block holding every row it has. Decoding block by block covers both,
+    // since a chunk boundary is always a row boundary.
+    let mut raw = Vec::with_capacity(raw_size);
     let mut offset = 2usize; // skip top_down + format bytes
