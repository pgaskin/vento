index a83c70e..109f225 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -6405,6 +6405,7 @@ dependencies = [
  "rand 0.8.7",
  "rcgen",
  "rsa",
+ "rustls",
  "rustls-pemfile",
  "serde",
  "sha1 0.10.7",
diff --git a/shakenfist-spice-compression/Cargo.toml b/shakenfist-spice-compression/Cargo.toml
index 3404b5d..858b6b7 100644
--- a/shakenfist-spice-compression/Cargo.toml
+++ b/shakenfist-spice-compression/Cargo.toml
@@ -12,7 +12,7 @@ readme = "README.md"
 workspace = true
 
 [features]
-default = ["quic", "glz", "lz", "lz4", "jpeg", "mozjpeg"]
+default = ["quic", "glz", "lz", "lz4", "jpeg", "mozjpeg", "h264"]
 quic = []
 glz = ["dep:tokio"]
 lz = []
@@ -25,6 +25,10 @@ jpeg = ["dep:jpeg-decoder"]
 # `JpegDecoder` trait surface exists; the pure-Rust
 # `jpeg-decoder` crate remains the universal fallback.
 mozjpeg = ["dep:mozjpeg", "jpeg"]
+# Software H.264 through openh264. Off, this crate is pure Rust and needs no
+# C++ toolchain; a consumer on a platform with a hardware decoder of its own
+# wants the stream data rather than a second software one.
+h264 = ["dep:openh264", "jpeg"]
 
 [dependencies]
 anyhow = "1"
@@ -51,7 +55,7 @@ mozjpeg = { version = "=0.10.13", optional = true, features = ["with_simd"] }
 # dependency). The same crate is used on the encode side in
 # shakenfist-spice-renderer/src/encoder/h264.rs. Used by
 # `H264VideoDecoder` in `src/video.rs`.
-openh264 = "0.9"
+openh264 = { version = "0.9", optional = true }
 
 # macOS-only: ImageIO JPEG decoder backend. Pinned to the 0.3.x
 # `objc2-*` family so the framework crates all agree on the
diff --git a/shakenfist-spice-compression/src/video.rs b/shakenfist-spice-compression/src/video.rs
