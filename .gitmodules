# `ignore = all` is required. A gitlink here always names the pristine upstream
# commit; the working tree is that commit plus the patches in patches/, applied
# by patch.sh. Without this, `git add -A` records the *patched* commit as the
# pin, after which the patches are applied on top of themselves and a fresh
# clone gets them twice. `patch.sh check` detects that; this prevents it.
[submodule "third_party/libvncserver"]
	path = third_party/libvncserver
	url = https://github.com/LibVNC/libvncserver.git
	shallow = true
	ignore = all
[submodule "third_party/libjpeg-turbo"]
	path = third_party/libjpeg-turbo
	url = https://github.com/libjpeg-turbo/libjpeg-turbo.git
	shallow = true
	ignore = all
[submodule "third_party/tigervnc"]
	path = third_party/tigervnc
	url = https://github.com/TigerVNC/tigervnc.git
	shallow = true
	ignore = all
[submodule "third_party/pixman"]
	path = third_party/pixman
	url = https://github.com/X11Libre/mirror.fdo.pixman.git
	shallow = true
	ignore = all
[submodule "third_party/openssl"]
	path = third_party/openssl
	url = https://github.com/openssl/openssl.git
	shallow = true
	ignore = all
[submodule "third_party/freerdp"]
	path = third_party/freerdp
	url = https://github.com/FreeRDP/FreeRDP.git
	shallow = true
	ignore = all
[submodule "third_party/ironrdp"]
	path = third_party/ironrdp
	url = https://github.com/Devolutions/IronRDP.git
	shallow = true
	ignore = all
[submodule "third_party/hbb_common"]
	path = third_party/hbb_common
	url = https://github.com/rustdesk/hbb_common.git
	shallow = true
	ignore = all
# RustDesk's client, for its message definitions alone
# (libs/base/protos/message.proto, which moved out of hbb_common), at the
# release tag. hbb_common above, which still holds rendezvous.proto, is pinned
# at the commit this release's libs/hbb_common names. Its own submodule is not
# needed and not initialised.
[submodule "third_party/rustdesk"]
	path = third_party/rustdesk
	url = https://github.com/rustdesk/rustdesk.git
	shallow = true
	ignore = all
[submodule "third_party/ryll"]
	path = third_party/ryll
	url = https://github.com/shakenfist/ryll.git
	shallow = true
	ignore = all
# The four below are used only by the host build, to run RealVNC's bionic
# viewer core in a glibc process (backends/modules/realvnc/cpp/host). None of
# them is in an APK or on its licence page; backends/platform/linux/ports/
# realvnc-host/meson.build lists each one's licence. mcpelauncher-linker's pin is on its
# `ng` branch and has two nested submodules (AOSP's bionic and core), so it is
# initialised with --recursive.
[submodule "third_party/logger"]
	path = third_party/logger
	url = https://github.com/minecraft-linux/logger.git
	shallow = true
	ignore = all
[submodule "third_party/libc-shim"]
	path = third_party/libc-shim
	url = https://github.com/minecraft-linux/libc-shim.git
	shallow = true
	ignore = all
[submodule "third_party/mcpelauncher-linker"]
	path = third_party/mcpelauncher-linker
	url = https://github.com/minecraft-linux/mcpelauncher-linker.git
	shallow = true
	ignore = all
[submodule "third_party/libjnivm"]
	path = third_party/libjnivm
	url = https://github.com/ChristopherHX/libjnivm.git
	shallow = true
	ignore = all
# Used only by the Linux client (linux/, a separate workspace, through its
# [patch.crates-io]): winit, at the tag of the release linux/Cargo.lock
# would otherwise take from crates.io, so that our fixes to it can be patches
# like the other submodules'. None of it is in an APK.
[submodule "third_party/winit"]
	path = third_party/winit
	url = https://github.com/rust-windowing/winit.git
	shallow = true
	ignore = all
# Used only by the Linux client, like winit: FFmpeg, linked by every desktop
# user of a video or sound codec (the Rust decoder, TigerVNC's H.264, FreeRDP's
# H.264, sound and scaling), built statically by
# backends/platform/linux/build.rs with --disable-everything and the
# decoders those use, and dav1d for its AV1. Each at a release tag (FFmpeg
# n8.1.3, dav1d 1.5.4). Android decodes with MediaCodec and builds neither.
# FFmpeg as configured is LGPL 2.1 or later, dav1d BSD-2-Clause.
[submodule "third_party/ffmpeg"]
	path = third_party/ffmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	shallow = true
	ignore = all
[submodule "third_party/dav1d"]
	path = third_party/dav1d
	url = https://github.com/videolan/dav1d.git
	shallow = true
	ignore = all
# Headers only, for that FFmpeg's hardware decoders: libva's (MIT; its one
# generated header, va_version.h, made by build.rs from its template) for
# VAAPI. Not compiled or linked: FFmpeg's VAAPI code calls libva through
# backends/platform/linux/cpp/va_shim.c, which loads it on first use.
# libva 2.23.0.
[submodule "third_party/libva"]
	path = third_party/libva
	url = https://github.com/intel/libva.git
	shallow = true
	ignore = all
