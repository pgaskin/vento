<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        A backend opens sockets from native code, where a missing permission
        surfaces as "socket: Operation not permitted" from inside the library
        rather than as a SecurityException.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A session has to survive the screen showing it going away, and about
        five seconds in the background is all it takes for Android to freeze a
        cached process and drop its sockets. A foreground service is the only
        answer, and its notification is the
        price: POST_NOTIFICATIONS is what makes that notification visible and
        therefore dismissible-by-disconnecting.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The lock screen in front of an export that carries the saved passwords
        in the clear. Not about biometrics: what is asked for is a device
        credential, and a fingerprint is only the quick way to give one.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        The uninstall on an add-on's card, which is one of the two things that
        card is for. Nothing here deletes anything: this is permission to ask,
        and what it asks is the system's own uninstaller, which shows its own
        dialog and takes its own answer. Without it that screen opens and closes
        again having decided the caller is not allowed to ask — no dialog, no
        error, a button that does nothing.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Add-ons: a package is visible here if it declares this action, and
        nothing in this manifest names one. An app that named a package, or
        asked for QUERY_ALL_PACKAGES, would be saying which add-on it is for —
        which is the thing keeping them separate is for.
    -->
    <queries>
        <intent>
            <action android:name="net.pgaskin.remotedesktop.action.BACKEND_PLUGIN" />
        </intent>
    </queries>

    <application
        android:name=".RemoteDesktopApp"
        android:dataExtractionRules="@xml/backup_rules"
        android:appComponentFactory="net.pgaskin.remotedesktop.AppFactory"
        tools:replace="android:appComponentFactory"
        android:manageSpaceActivity="net.pgaskin.remotedesktop.ManageSpaceActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.RemoteDesktop">

        <!-- The saved connections, and the way in to everything else. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!--
            "Manage space", in the system's own storage page for this app.
            Declaring it replaces the platform's "Clear storage" button, which is
            the trade: that button deletes everything at once with no idea what
            any of it is, and this one lands on the screen where each store — the
            settings, the connections, the accepted servers, the plugin
            libraries, the recordings — is deleted knowing what it is.

            An alias rather than a screen of its own, because it *is* that
            screen: `manageSpaceActivity` can only name a component and cannot
            carry an extra, so which section it means is said here, in the
            meta-data SettingsActivity falls back to. Exported because the system
            settings app is the one starting it — so any app on the phone can
            open this screen too, which is a screen where nothing happens
            without somebody answering a dialog on it.

            The attribute above spells the class out, where every other name here
            is written against the package. Nothing expands that one at build
            time, so it is the *installed* package a leading dot is resolved
            against — and this build has a debug variant whose applicationId is
            not the namespace these classes are in. A relative name there is a
            button that opens nothing, in the one variant nobody would think to
            check.
        -->
        <activity-alias
            android:name=".ManageSpaceActivity"
            android:targetActivity=".SettingsActivity"
            android:label="@string/settings_transfer"
            android:exported="true">
            <meta-data
                android:name="section"
                android:value="transfer" />
        </activity-alias>

        <!-- The licence page the build generates into the assets. -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <!--
            The fake desktop the input stack was built against — the whole
            app before there was a protocol to speak, and now a screen
            reachable from settings.

            Unlike the original we keep configChanges, so rotating resizes the
            view in place instead of recreating the activity: the cursor
            position, the option squares and an armed fixture recording all
            survive a rotation, which they must for this to be usable as a test
            harness.
        -->
        <activity
            android:name=".PlaygroundActivity"
            android:exported="true"
            android:theme="@style/Theme.RemoteDesktop.Session"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!--
            One connection, on screen. Launched from the home screen with a
            connection id, or straight from adb with an address (session.sh).
            A rotation must not drop a live connection, hence configChanges.

            A window per session, which is what documentLaunchMode buys: the
            home screen gives each launch the connection's own URI, so a second
            machine opens beside the first and both are live, while opening one
            that is already running — from the list or from its notification —
            lands in the window it already has. `intoExisting` rather than
            `always` is the whole of that rule. autoRemoveFromRecents because a
            session deliberately ended has no window left to go back to; one
            that ended by itself keeps its window, and the reason on it.

            Exported for that second way in, and the trade is worth stating:
            any app on the phone can make this one open a session to an address
            of its choosing. It cannot reach a saved connection's password
            without its id, which it would have to guess, and it cannot see what
            arrives — but it can start a connection, and that is the cost of
            being drivable from a script.
        -->
        <activity
            android:name=".SessionActivity"
            android:exported="true"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="true"
            android:theme="@style/Theme.RemoteDesktop.Session"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!--
            The session's keeper. `specialUse` because none of the defined types
            is this: it is not a data sync (which Android 15 caps at six hours,
            and a session is as long as somebody is working), not a connected
            device, not media. The subtype below is the declaration that goes
            with it.
        -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="remote_desktop_session" />
        </service>

        <!--
            Where a session's timeout alarm comes back, which is the app's own
            process and nobody else's business.
        -->
        <receiver
            android:name=".Session$Timeout"
            android:exported="false" />

        <!--
            How a screenshot leaves: a file in this app's own cache, handed to
            whichever app the share sheet lands on as a read grant for that one
            URI. Not shared storage — a picture of somebody's desktop has no
            business in the gallery, and this way nothing outside the chosen app
            can read it and even that ends with the task.

            `exported` false and no permission of its own: the grant travelling
            with the intent is the whole of the access, so nothing that was not
            handed a URI can ask for one. The authority is written against
            ${applicationId} rather than the namespace, because the debug
            variant's package is not the namespace and two authorities that are
            the same string cannot both be installed on one phone.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

    </application>

</manifest>
