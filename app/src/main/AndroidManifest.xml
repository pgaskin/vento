<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        A backend opens sockets from native code, where a missing permission
        surfaces as "socket: Operation not permitted" from inside the library
        rather than as a SecurityException.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A session has to outlive its activity, and Android freezes a cached
        process and drops its sockets after about five seconds in the
        background. A foreground service prevents that. POST_NOTIFICATIONS
        makes the service's notification visible, and its disconnect action
        usable.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The lock screen shown before an export that includes the saved
        passwords in the clear. It asks for a device credential; a fingerprint
        is one way to give it.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        The uninstall button on an add-on's card. This only allows starting
        the system uninstaller, which shows its own confirmation dialog.
        Without it the uninstaller opens and closes again immediately with no
        dialog and no error.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Add-ons: a package is visible if it declares this action. No package
        is named here and QUERY_ALL_PACKAGES is not requested, so the app does
        not depend on any particular add-on.
    -->
    <queries>
        <intent>
            <action android:name="net.pgaskin.remotedesktop.action.BACKEND_PLUGIN" />
        </intent>
    </queries>

    <!--
        RTL mirroring is enabled because every layout uses start and end, never
        left and right. The session screen draws the desktop and is unaffected.
    -->
    <application
        android:name=".RemoteDesktopApp"
        android:dataExtractionRules="@xml/backup_rules"
        android:appComponentFactory="net.pgaskin.remotedesktop.AppFactory"
        tools:replace="android:appComponentFactory"
        android:manageSpaceActivity="net.pgaskin.remotedesktop.ManageSpaceActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteDesktop">

        <!-- The saved connections, and the entry point to everything else. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!--
            "Manage space" in the system's storage page for this app. Declaring
            it replaces the platform's "Clear storage" button, which deletes
            everything at once, with the settings section where each store (the
            settings, the connections, the accepted servers, the plugin
            libraries, the recordings) is deleted separately.

            An alias of SettingsActivity because `manageSpaceActivity` can only
            name a component and cannot carry an extra, so the section is given
            in the meta-data SettingsActivity falls back to. Exported because
            the system settings app starts it, so any app can open this screen
            too; nothing on it happens without confirming a dialog.

            The attribute above spells the class out, unlike every other name
            here. It is not expanded at build time, so a leading dot would be
            resolved against the installed package, and the debug variant's
            applicationId is not the namespace these classes are in. A relative
            name there would open nothing in the debug build.
        -->
        <activity-alias
            android:name=".ManageSpaceActivity"
            android:targetActivity=".SettingsActivity"
            android:label="@string/settings_transfer"
            android:exported="true">
            <meta-data
                android:name="section"
                android:value="transfer" />
        </activity-alias>

        <!-- Shows the licence page the build generates into the assets. -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <!--
            The fake desktop the input stack was built against, reachable from
            settings.

            configChanges makes rotation resize the view in place instead of
            recreating the activity, so the cursor position, the option squares
            and an armed fixture recording survive it, as a test harness needs.
        -->
        <activity
            android:name=".PlaygroundActivity"
            android:exported="true"
            android:theme="@style/Theme.RemoteDesktop.Session"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!--
            One connection on screen. Launched from the home screen with a
            connection id, or from adb with an address (scripts/session.sh)
            when the developer setting allowing it is on.
            A rotation must not drop a live connection, hence configChanges.

            documentLaunchMode gives each session its own window: the home
            screen gives each launch the connection's own URI, so a second
            machine opens beside the first and both stay live, while opening
            one that is already running (from the list or its notification)
            returns to its existing window. That is `intoExisting` rather than
            `always`. autoRemoveFromRecents because a session ended by the user
            has no window left to return to; one that ended by itself keeps its
            window and the reason shown on it.

            Exported for the adb entry point. Any app can open a saved
            connection if it can guess its id, but cannot see the session.
            Starting a connection to an address of its choice needs developer
            mode and "Allow external apps to launch connections"
            (AppSettings.externalLaunch); without them the activity finishes
            without connecting.
        -->
        <activity
            android:name=".SessionActivity"
            android:exported="true"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="true"
            android:theme="@style/Theme.RemoteDesktop.Session"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!--
            Keeps sessions alive. `specialUse` because no defined type fits: it
            is not a data sync (which Android 15 caps at six hours, while a
            session lasts as long as it is in use), not a connected device, not
            media. The subtype below is the declaration it requires.
        -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="remote_desktop_session" />
        </service>

        <!--
            Receives a session's timeout alarm, which the app sets for itself,
            so it is not exported.
        -->
        <receiver
            android:name=".Session$Timeout"
            android:exported="false" />

        <!--
            Shares screenshots: a file in this app's cache, passed to the app
            chosen in the share sheet as a read grant for that one URI. Not
            shared storage, so a desktop screenshot does not end up in the
            gallery, nothing outside the chosen app can read it, and the grant
            ends with the task.

            Not exported and no permission of its own: the grant sent with the
            intent is the only access, so an app without a granted URI cannot
            request one. The authority uses ${applicationId} rather than the
            namespace because the debug variant's package differs from the
            namespace, and two installed packages cannot declare the same
            authority.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

    </application>

</manifest>
