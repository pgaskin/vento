    The backend badge on a home card. A scrim rather than a theme colour: it
    sits over somebody's desktop, which may be any colour at all, so it has to
    carry its own contrast instead of borrowing the surface's.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#99000000" />
    <corners android:radius="6dp" />
</shape>
