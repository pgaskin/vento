<!-- The first row of a group: large at the top, small where the next row is. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceBright" />
            <corners
                android:bottomLeftRadius="@dimen/group_radius_inner"
                android:bottomRightRadius="@dimen/group_radius_inner"
                android:topLeftRadius="@dimen/group_radius"
                android:topRightRadius="@dimen/group_radius" />
        </shape>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners
                android:bottomLeftRadius="@dimen/group_radius_inner"
                android:bottomRightRadius="@dimen/group_radius_inner"
                android:topLeftRadius="@dimen/group_radius"
                android:topRightRadius="@dimen/group_radius" />
        </shape>
    </item>

</ripple>
