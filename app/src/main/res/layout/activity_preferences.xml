    SPDX-License-Identifier: GPL-3.0-or-later

    A header over a fragment or a view: the settings tree's frame, and the
    licence page's.

    The header is built here rather than being a toolbar, which is what this
    was. A toolbar lays its navigation button out where it decides — 8 dp in,
    whatever it is told about padding or content insets — and the back button
    has to line up with the header of every other screen, all of which are
    built like this one. What a toolbar was giving in exchange was a title and
    a click listener.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/header_inset_button"
        android:paddingEnd="@dimen/header_inset">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.RemoteDesktop.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/nav_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
