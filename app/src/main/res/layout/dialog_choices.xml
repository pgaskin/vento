    The body of a choice dialog: the described values, one under the other. A
    scroller because the list belongs to a backend and the phone decides how
    much of it fits; an AlertDialog scrolls its message and not the view put in
    place of one.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadingEdgeLength="16dp"
    android:requiresFadingEdge="vertical">

    <LinearLayout
        android:id="@+id/items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</ScrollView>
