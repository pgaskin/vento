<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Patrick Gaskin
    SPDX-License-Identifier: GPL-3.0-or-later

    One androidx preference, drawn as a row of a group: the same metrics as the
    hand-built rows in the panel and the editor, since one description of an
    option is drawn by both.

    No icon frame and no background. Nothing here reserves room for an icon
    because nothing in this app sets one, and the background belongs to the
    adapter — which is the only thing that knows where in its group a row sits.

    The ids are androidx's own and are what binds it: title, summary and
    widget_frame are looked up by name.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:paddingStart="@dimen/row_padding"
    android:paddingEnd="@dimen/row_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/row_padding"
        android:paddingBottom="@dimen/row_padding">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/row_padding"
        android:paddingEnd="0dp" />

</LinearLayout>
