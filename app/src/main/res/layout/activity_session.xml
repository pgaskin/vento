    The views over the desktop. The desktop itself is added underneath in code,
    since a SessionView needs its host and backend, which XML attributes cannot
    express.

    Only the two buttons are clickable, and a view that does not handle touches
    passes them to the view below, so the whole screen is still the touch
    surface.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!--
        Dims the desktop while it cannot be used.

        Surface colour rather than the black a dialog dims with, because this
        is not a modal over the session but the session itself in a state where
        touching it does nothing. Heavier than a dialog's scrim for the same
        reason: a bottom sheet covers the desktop briefly and this covers it
        until the connection comes back, so the text over it has to stand out.
    -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.72"
        android:background="?attr/colorSurface"
        android:visibility="gone" />

    <!--
        The message a session ends with, and two actions: reconnect, and open
        the log the message is the last line of. Buttons rather than an
        unmarked tap region, so each action has a visible touch target.
    -->
    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/session_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Above the text rather than beside it: the panel is centred, and a
             message that wraps to two lines would pull a leading spinner off
             centre. -->
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/loading"
            style="@style/Widget.Material3.LoadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <!-- dp rather than sp, as for the diagnostic readout: this is a label
             over a desktop whose own text it has to stay distinguishable from,
             so its size does not follow the font scale. -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:textColor="@color/session_ink"
            android:textSize="14dp"
            tools:ignore="SpUsage" />

        <!-- What the connection is waiting for, under the address it is
             connecting to, in the same style: shown only while connecting,
             and only when the backend says. -->
        <TextView
            android:id="@+id/status_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:textColor="@color/session_ink"
            android:textSize="14dp"
            android:visibility="gone"
            tools:ignore="SpUsage" />

        <!-- The panel is as wide as the message, which is wider than the two
             buttons; without the gravity they sit under its start. -->
        <LinearLayout
            android:id="@+id/status_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <!-- Borderless, so they do not look like panels inside the panel. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reconnect"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_reconnect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/log"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_log" />
        </LinearLayout>
    </LinearLayout>
</merge>
