    Title, add, settings, and the connections — cards or rows, which the bar
    chooses — scrolling behind the bar. The bar is the window's own background
    colour rather than transparent: an item sliding under a see-through bar is
    legible enough to look like a bug and not legible enough to read.

    The side padding is HomeActivity's, since it belongs to the shape: a card
    carries its own margin and a row takes the group inset instead.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!--
        Nothing saved yet, which is what this screen looks like exactly once.
        A picture of the thing there are none of, what there are none of, and
        what to do about it — the button it names is on the screen underneath
        this, which is why the description points at it rather than repeating
        it as a second button.
    -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_desktop"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_empty_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/home_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- The other way in, which only matters when there is no other way in:
             the playground needs no machine at all. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/playground"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_empty_playground" />

    </LinearLayout>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer"
        app:contentInsetStart="@dimen/header_inset"
        app:title="@string/app_name" />

    <!--
        Adding a connection is the one thing this screen is for when it is
        empty, and the only action on it that makes something; the bar keeps
        settings, which is a way out rather than an action. The list's bottom
        padding is what keeps the last row clear of it (HomeActivity).
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/home_add"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
