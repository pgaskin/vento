<!--
    SPDX-FileCopyrightText: 2026 Patrick Gaskin
    SPDX-License-Identifier: GPL-3.0-or-later

    The pinned connections, in the order they sit in at the top of the home
    screen, to be dragged into another one.

    A sheet of its own rather than a mode over the list, because the list is
    where a card is pressed to open a machine and long-pressed to edit it, and
    a third meaning for the same finger on the same card is one too many. What
    is here is only the pinned ones and only their names: a reorder is about
    which is first, so a picture of each desktop would be the largest thing on
    a screen that nobody opened to look at desktops.

    Wrap content, not a weight: the sheet is as tall as however many pins there
    are, and the list scrolls only once that is more than the screen holds —
    which is what measuring the rows against the height the sheet is offered
    does for us.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/group_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingStart="@dimen/header_inset"
        android:paddingTop="@dimen/header_padding"
        android:paddingEnd="@dimen/header_inset_button"
        android:paddingBottom="@dimen/header_padding">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_reorder"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.RemoteDesktop.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/panel_close"
            app:icon="@drawable/ic_close" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false" />

</LinearLayout>
