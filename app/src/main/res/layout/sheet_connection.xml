    The connection panel: what the `information` tap region opens.

    One sheet, no nesting. The order is the reverse of RealVNC Viewer's
    information screen: the controls come first because this is opened to
    *change* something (nearly always the picture quality), and the facts
    below are read after deciding something is wrong. Both lists are generated
    (the backend's live options and facts), so this file only defines the
    frame around them.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!--
            The desktop's own name is the heading, not a row, since the whole
            panel is about it. Under it, the state and the size, which are
            always known locally and immediately.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="?attr/actionBarSize"
            android:orientation="horizontal"
            android:paddingStart="@dimen/header_inset"
            android:paddingTop="@dimen/header_padding"
            android:paddingEnd="@dimen/header_inset_button"
            android:paddingBottom="@dimen/header_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/close"
                style="@style/Widget.RemoteDesktop.HeaderButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/panel_close"
                app:icon="@drawable/ic_close" />

        </LinearLayout>

        <!--
            The groups are separated by the gap between them rather than by a
            divider: each is a container of rows with large corners, and an
            empty one is hidden along with its margin.
        -->

        <!-- The backend's live options, rendered by PanelOptions. -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/group_spacing"
            android:orientation="vertical" />

        <!--
            Which of the far end's screens it is sending, above the desktop size
            because the screen determines the size. Only one protocol here
            sends one screen at a time, so this is usually hidden.
        -->
        <LinearLayout
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/group_spacing"
            android:orientation="vertical" />

        <!--
            The desktop size, which is a control and not an option: whether it
            can be offered at all is a fact about the live connection, so the
            row can appear and disappear while the panel is open, and
            ConnectionPanel builds it from the session's current state.
        -->
        <LinearLayout
            android:id="@+id/resize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/group_spacing"
            android:orientation="vertical" />

        <!--
            The session's sound switch, Enable audio or Mute audio, shown once
            the far end may send sound and hidden where it never will: live
            session state rather than an option, built by ConnectionPanel.
        -->
        <LinearLayout
            android:id="@+id/sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/group_spacing"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/facts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/group_spacing"
            android:orientation="vertical" />

        <!--
            The diagnostics, not collapsed: they are how a quality change is
            *checked*. The viewer format changing to `depth 3 (8 bpp) rgb111` is
            the only on-screen confirmation that the control did anything, and
            collapsing it would cost a tap every time.
        -->
        <LinearLayout
            android:id="@+id/diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!--
            What carries the connection where it is not this end's own TCP
            connection (a tunnel): last, and gone where there is none.
        -->
        <LinearLayout
            android:id="@+id/tunnel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_spacing"
            android:orientation="vertical"
            android:visibility="gone" />

        <!--
            Three buttons. At the end of the row: Log, always, and beside it
            Disconnect or Reconnect depending on the session's state
            (ConnectionPanel sets the text and the action). At the start, alone,
            the screenshot button, which does not act on the session.

            Disconnect duplicates the disconnect tap region and the back
            gesture, but those are an unlabelled corner of the screen and a
            gesture, and the panel is where the connection's state is shown. It
            asks the same confirmation and ends the session the same way.

            There is no link to the connection editor: it edits the *saved*
            connection, and no change there reaches the current session until
            the next one, so offering it from a live session's panel would be
            misleading.
        -->
        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="@dimen/group_spacing"
            android:paddingEnd="16dp">

            <!--
                Captures the desktop and passes it to the share sheet. At the
                other end of the row because it is the only button here that
                does not act on the session: the other two end it or explain it.

                Without the outline the editor's pin has, for the reason given
                there: an outlined icon button is a toggle that fills in when
                on, and this is an action with no state.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/screenshot"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/panel_screenshot"
                app:icon="@drawable/ic_screenshot_region" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/log"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/panel_log" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_disconnect" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
