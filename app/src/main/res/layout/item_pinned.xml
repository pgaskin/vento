    One pinned connection, waiting to be moved: what it is called, where it is,
    and the handle that picks it up.

    Each row is its own container, which is the one place in this app that a run
    of rows is not a single group. A group's row wears one of four backgrounds
    chosen from where it sits, and where these sit is exactly what a drag is
    changing — so the two rows either side of a swap would have to relearn their
    corners half way through the gesture. A row that can be picked up is a thing
    rather than a line of a list, and it is drawn as one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_group_single"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

    </LinearLayout>

    <!--
        What the finger goes on. A long press anywhere on the row picks it up as
        well, since that is what a reorderable list does everywhere else; the
        handle is what says so without having to be discovered.
    -->
    <ImageView
        android:id="@+id/drag"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/home_reorder_drag"
        android:padding="12dp"
        android:src="@drawable/ic_drag"
        app:tint="?android:attr/textColorSecondary" />

</LinearLayout>
