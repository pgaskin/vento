    SPDX-License-Identifier: GPL-3.0-or-later

    A BackendOption.Type.BOOL, live. The whole row is the target and the switch
    is decoration on it — a 48 dp strip is easier to hit than a switch, and this
    is a panel opened one-handed over a desktop.

    The background is the group's, put on by RowGroups, and carries the ripple
    with it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/row_padding"
    android:paddingEnd="@dimen/row_padding">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
