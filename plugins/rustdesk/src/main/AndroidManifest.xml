<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Both of these come from `:plugins`, where an add-on that acquires
        something needs them. This one acquires nothing: its backend runs in the
        app's process and spends the app's network permission, and a package
        asking for one it never uses is a package saying something untrue about
        itself.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
        Nothing is stored here and nothing is acquired: this add-on is the
        backend and its library, and the only reason it is a package of its own
        is what it would put on the app's listing. So there is no activity, no
        provider, and no data directory worth carrying anywhere.

        The marker service the app discovers by comes from `:plugins`, along
        with the two permissions an acquiring add-on needs and this one does
        not use.
    -->
    <!-- No icon, because there is no launcher entry to put one on. -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        tools:ignore="MissingApplicationIcon">

        <!--
            The one thing this package says about itself that is for the app to
            read: where a build of it for the app's version is, and what the
            file there is signed with. Both values are in this module's
            build.gradle, which is where the reasoning about them is.

            Meta-data because this is read out of a package whose dex the app
            has refused to load — being built for another version of the app is
            the whole reason anybody is asking.
        -->
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateUrl"
            android:value="${updateUrl}" />
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateSignature"
            android:value="${updateSignature}" />

    </application>

</manifest>
