<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Everything this add-on holds is somebody else's binary, acquired on the
        phone it is for. Backing it up would send it off the device by a route
        nobody chose, and restoring it would put a build for one ABI on another
        — which the hash refuses, so the only thing a backup could achieve here
        is the part that is not wanted.
    -->
    <!-- No icon, because there is no launcher entry to put one on. -->
    <application
        android:label="@string/app_name"
        tools:ignore="MissingApplicationIcon"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:theme="@style/Theme.Plugin">

        <!--
            The one thing this package says about itself that is for the app to
            read: where a build of it for the app's version is, and what the
            file there is signed with. Both values are in this module's
            build.gradle, which is where the reasoning about them is.

            Meta-data because this is read out of a package whose dex the app
            has refused to load — being built for another version of the app is
            the whole reason anybody is asking.
        -->
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateUrl"
            android:value="${updateUrl}" />
        <meta-data
            android:name="net.pgaskin.remotedesktop.plugin.updateSignature"
            android:value="${updateSignature}" />

        <!--
            No launcher filter: this is reached from the app and from nowhere
            else. Exported for that, since the app is another package.
        -->
        <activity
            android:name="net.pgaskin.remotedesktop.realvnc.RealVncSetupActivity"
            android:exported="true"
            android:label="@string/setup_title">
            <intent-filter>
                <action android:name="net.pgaskin.remotedesktop.action.SETUP_PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The one way anything of this add-on's leaves its uid. The authority
            carries the applicationId so that a debug build and a release one
            can be installed side by side.
        -->
        <provider
            android:name="net.pgaskin.remotedesktop.realvnc.RealVncLibraryProvider"
            android:authorities="${applicationId}.libraries"
            android:exported="true"
            android:grantUriPermissions="false"
            tools:ignore="ExportedContentProvider" />

    </application>

</manifest>
