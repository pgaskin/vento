<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plugin_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:focusableInTouchMode="true"><!-- or the first button takes focus and scrolls to itself -->

        <TextView
            android:id="@+id/plugin_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/plugin_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/plugin_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="?android:attr/colorError"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/plugin_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/plugin_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/plugin_from_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plugin_from_file" />

            <Button
                android:id="@+id/plugin_from_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plugin_from_download" />

        </LinearLayout>

        <!-- Only for the one failure a person can do something about. -->
        <Button
            android:id="@+id/plugin_fix_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/plugin_allow_network"
            android:visibility="gone" />

        <TextView
            android:id="@+id/plugin_pins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:typeface="monospace"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
