# The RustDesk desktop with a sound to send: `AUDIO=1 ./run.sh` (usage.md).
#
# Built on top of the protorustdesk image rather than into it, as
# scripts/testqemu's audio guest is, so a rebuild of this one never changes
# the image the shared container runs. What it adds is a PulseAudio server
# with a null sink as the default, which their server records from (the
# default sink's monitor, as on any Linux desktop), and testqemu's
# `audio/tone.c` playing into it through ALSA's PulseAudio plugin: silence,
# and a 440 Hz burst per 't' on a TCP port, answered with its own share of
# the delay, so that scripts/testaudio/bursts.py times it as it times the
# QEMU guest. Their server records it through their connection manager, which
# needs a logged-in user (loginctl), sudo and EGL here (usage.md). Build with
# the tone's source as a second context:
#
#   docker build -t protorustdesk-audio -f Dockerfile.audio \
#       --build-context tonesrc=../testqemu/audio .
ARG BASE=protorustdesk:latest

FROM debian:trixie AS tone
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libasound2-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=tonesrc tone.c /src/tone.c
RUN gcc -O2 -Wall -o /tone /src/tone.c -lasound -lm

FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        pulseaudio \
        pulseaudio-utils \
        `# ALSA's "pulse" device, which is what the tone plays into` \
        libasound2-plugins \
        `# the serial line the QEMU guest has, as a pty on a TCP port` \
        socat \
        `# their connection manager, which records the sound, is a Flutter` \
        `# window from 1.5.0 on (1.4.9 had a headless one, --cm-no-ui) and` \
        `# aborts without EGL and GLES: Mesa's, rendering in software on Xvfb` \
        libegl1 \
        libegl-mesa0 \
        libgles2 \
        libgl1-mesa-dri \
        `# how their server, as root, starts that manager as the logged-in user` \
        sudo \
    && rm -rf /var/lib/apt/lists/*
# Who is logged in, for their server, which asks loginctl (see the script).
# With no logind to answer, 1.5.0's server takes the desktop for a login
# screen: its audio service then waits for a login and never records, and it
# never starts or talks to the connection manager.
COPY loginctl /usr/local/bin/loginctl
# The manager's window, minimised by Openbox as it first maps, so the desktop
# looks the same as the protorustdesk image's during a session.
RUN mkdir -p /root/.config/openbox \
    && sed 's|</applications>|<application class="Rustdesk"><iconic>yes</iconic></application>\n</applications>|' \
        /etc/xdg/openbox/rc.xml > /root/.config/openbox/rc.xml \
    && grep -c 'class="Rustdesk"' /root/.config/openbox/rc.xml | grep -qx 1
COPY --from=tone /tone /usr/local/bin/tone
COPY start.sh /usr/local/bin/start.sh
COPY start-audio.sh /usr/local/bin/start-audio.sh
RUN chmod +x /usr/local/bin/start.sh /usr/local/bin/start-audio.sh /usr/local/bin/loginctl
EXPOSE 4555
ENTRYPOINT ["/usr/local/bin/start-audio.sh"]
